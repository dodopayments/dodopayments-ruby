module Dodopayments
  module Models
    type invoice_update_params =
      {
        invoice_id: String,
        if_match: String,
        billing_address: Dodopayments::InvoiceUpdateParams::BillingAddress?,
        cc_emails: ::Array[String]?,
        collection_method: Dodopayments::Models::collection_method?,
        currency: Dodopayments::Models::currency?,
        customer_email: String?,
        customer_id: String?,
        discount_ids: ::Array[String]?,
        due_at: Time?,
        dunning: Dodopayments::InvoiceUpdateParams::Dunning?,
        items: ::Array[Dodopayments::Models::InvoiceUpdateParams::item]?,
        memo: String?,
        metadata: Dodopayments::Models::metadata?,
        payment_terms: Dodopayments::Models::InvoiceUpdateParams::payment_terms?,
        review_required: bool?,
        tax_id: String?
      }
      & Dodopayments::Internal::Type::request_parameters

    class InvoiceUpdateParams < Dodopayments::Internal::Type::BaseModel
      extend Dodopayments::Internal::Type::RequestParameters::Converter
      include Dodopayments::Internal::Type::RequestParameters

      attr_accessor invoice_id: String

      attr_accessor if_match: String

      attr_accessor billing_address: Dodopayments::InvoiceUpdateParams::BillingAddress?

      attr_accessor cc_emails: ::Array[String]?

      attr_accessor collection_method: Dodopayments::Models::collection_method?

      attr_accessor currency: Dodopayments::Models::currency?

      attr_accessor customer_email: String?

      attr_accessor customer_id: String?

      attr_accessor discount_ids: ::Array[String]?

      attr_accessor due_at: Time?

      attr_accessor dunning: Dodopayments::InvoiceUpdateParams::Dunning?

      attr_accessor items: ::Array[Dodopayments::Models::InvoiceUpdateParams::item]?

      attr_accessor memo: String?

      attr_accessor metadata: Dodopayments::Models::metadata?

      attr_accessor payment_terms: Dodopayments::Models::InvoiceUpdateParams::payment_terms?

      attr_accessor review_required: bool?

      attr_accessor tax_id: String?

      def initialize: (
        invoice_id: String,
        if_match: String,
        ?billing_address: Dodopayments::InvoiceUpdateParams::BillingAddress?,
        ?cc_emails: ::Array[String]?,
        ?collection_method: Dodopayments::Models::collection_method?,
        ?currency: Dodopayments::Models::currency?,
        ?customer_email: String?,
        ?customer_id: String?,
        ?discount_ids: ::Array[String]?,
        ?due_at: Time?,
        ?dunning: Dodopayments::InvoiceUpdateParams::Dunning?,
        ?items: ::Array[Dodopayments::Models::InvoiceUpdateParams::item]?,
        ?memo: String?,
        ?metadata: Dodopayments::Models::metadata?,
        ?payment_terms: Dodopayments::Models::InvoiceUpdateParams::payment_terms?,
        ?review_required: bool?,
        ?tax_id: String?,
        ?request_options: Dodopayments::request_opts
      ) -> void

      def to_hash: -> {
        invoice_id: String,
        if_match: String,
        billing_address: Dodopayments::InvoiceUpdateParams::BillingAddress?,
        cc_emails: ::Array[String]?,
        collection_method: Dodopayments::Models::collection_method?,
        currency: Dodopayments::Models::currency?,
        customer_email: String?,
        customer_id: String?,
        discount_ids: ::Array[String]?,
        due_at: Time?,
        dunning: Dodopayments::InvoiceUpdateParams::Dunning?,
        items: ::Array[Dodopayments::Models::InvoiceUpdateParams::item]?,
        memo: String?,
        metadata: Dodopayments::Models::metadata?,
        payment_terms: Dodopayments::Models::InvoiceUpdateParams::payment_terms?,
        review_required: bool?,
        tax_id: String?,
        request_options: Dodopayments::RequestOptions
      }

      type billing_address =
        {
          country: Dodopayments::Models::country_code,
          city: String?,
          state: String?,
          street: String?,
          zipcode: String?
        }

      class BillingAddress < Dodopayments::Internal::Type::BaseModel
        attr_accessor country: Dodopayments::Models::country_code

        attr_accessor city: String?

        attr_accessor state: String?

        attr_accessor street: String?

        attr_accessor zipcode: String?

        def initialize: (
          country: Dodopayments::Models::country_code,
          ?city: String?,
          ?state: String?,
          ?street: String?,
          ?zipcode: String?
        ) -> void

        def to_hash: -> {
          country: Dodopayments::Models::country_code,
          city: String?,
          state: String?,
          street: String?,
          zipcode: String?
        }
      end

      type dunning =
        { reminders_enabled: bool, offsets_days: ::Array[Integer]? }

      class Dunning < Dodopayments::Internal::Type::BaseModel
        attr_accessor reminders_enabled: bool

        attr_accessor offsets_days: ::Array[Integer]?

        def initialize: (
          reminders_enabled: bool,
          ?offsets_days: ::Array[Integer]?
        ) -> void

        def to_hash: -> {
          reminders_enabled: bool,
          offsets_days: ::Array[Integer]?
        }
      end

      type item =
        Dodopayments::InvoiceUpdateParams::Item::CustomItem
        | Dodopayments::InvoiceUpdateParams::Item::ProductItem

      module Item
        extend Dodopayments::Internal::Type::Union

        type custom_item =
          {
            description: String,
            kind: :custom,
            tax_category: Dodopayments::Models::tax_category,
            unit_amount: Integer,
            quantity: Integer?
          }

        class CustomItem < Dodopayments::Internal::Type::BaseModel
          attr_accessor description: String

          attr_accessor kind: :custom

          attr_accessor tax_category: Dodopayments::Models::tax_category

          attr_accessor unit_amount: Integer

          attr_accessor quantity: Integer?

          def initialize: (
            description: String,
            tax_category: Dodopayments::Models::tax_category,
            unit_amount: Integer,
            ?quantity: Integer?,
            ?kind: :custom
          ) -> void

          def to_hash: -> {
            description: String,
            kind: :custom,
            tax_category: Dodopayments::Models::tax_category,
            unit_amount: Integer,
            quantity: Integer?
          }
        end

        type product_item =
          {
            product_id: String,
            quantity: Integer,
            addons: ::Array[Dodopayments::AttachAddon]?
          }

        class ProductItem < Dodopayments::Internal::Type::BaseModel
          attr_accessor product_id: String

          attr_accessor quantity: Integer

          attr_accessor addons: ::Array[Dodopayments::AttachAddon]?

          def initialize: (
            product_id: String,
            quantity: Integer,
            ?addons: ::Array[Dodopayments::AttachAddon]?
          ) -> void

          def to_hash: -> {
            product_id: String,
            quantity: Integer,
            addons: ::Array[Dodopayments::AttachAddon]?
          }
        end

        def self?.variants: -> ::Array[Dodopayments::Models::InvoiceUpdateParams::item]
      end

      type payment_terms =
        Dodopayments::InvoiceUpdateParams::PaymentTerms::DueOnReceipt
        | Dodopayments::InvoiceUpdateParams::PaymentTerms::Net

      module PaymentTerms
        extend Dodopayments::Internal::Type::Union

        type due_on_receipt = { type: :due_on_receipt }

        class DueOnReceipt < Dodopayments::Internal::Type::BaseModel
          attr_accessor type: :due_on_receipt

          def initialize: (?type: :due_on_receipt) -> void

          def to_hash: -> { type: :due_on_receipt }
        end

        type net = { days: Integer, type: :net }

        class Net < Dodopayments::Internal::Type::BaseModel
          attr_accessor days: Integer

          attr_accessor type: :net

          def initialize: (days: Integer, ?type: :net) -> void

          def to_hash: -> { days: Integer, type: :net }
        end

        def self?.variants: -> ::Array[Dodopayments::Models::InvoiceUpdateParams::payment_terms]
      end
    end
  end
end
