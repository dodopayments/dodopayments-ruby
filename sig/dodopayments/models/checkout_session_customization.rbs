module Dodopayments
  module Models
    type checkout_session_customization =
      {
        force_language: String?,
        payment_method_layout: Dodopayments::Models::CheckoutSessionCustomization::payment_method_layout?,
        show_on_demand_tag: bool,
        show_order_details: bool,
        theme: Dodopayments::Models::CheckoutSessionCustomization::theme?,
        theme_config: Dodopayments::ThemeConfig?
      }

    class CheckoutSessionCustomization < Dodopayments::Internal::Type::BaseModel
      attr_accessor force_language: String?

      attr_accessor payment_method_layout: Dodopayments::Models::CheckoutSessionCustomization::payment_method_layout?

      attr_reader show_on_demand_tag: bool?

      def show_on_demand_tag=: (bool) -> bool

      attr_reader show_order_details: bool?

      def show_order_details=: (bool) -> bool

      attr_accessor theme: Dodopayments::Models::CheckoutSessionCustomization::theme?

      attr_accessor theme_config: Dodopayments::ThemeConfig?

      def initialize: (
        ?force_language: String?,
        ?payment_method_layout: Dodopayments::Models::CheckoutSessionCustomization::payment_method_layout?,
        ?show_on_demand_tag: bool,
        ?show_order_details: bool,
        ?theme: Dodopayments::Models::CheckoutSessionCustomization::theme?,
        ?theme_config: Dodopayments::ThemeConfig?
      ) -> void

      def to_hash: -> {
        force_language: String?,
        payment_method_layout: Dodopayments::Models::CheckoutSessionCustomization::payment_method_layout?,
        show_on_demand_tag: bool,
        show_order_details: bool,
        theme: Dodopayments::Models::CheckoutSessionCustomization::theme?,
        theme_config: Dodopayments::ThemeConfig?
      }

      type payment_method_layout = :accordion | :tabs

      module PaymentMethodLayout
        extend Dodopayments::Internal::Type::Enum

        ACCORDION: :accordion
        TABS: :tabs

        def self?.values: -> ::Array[Dodopayments::Models::CheckoutSessionCustomization::payment_method_layout]
      end

      type theme = :dark | :light | :system

      module Theme
        extend Dodopayments::Internal::Type::Enum

        DARK: :dark
        LIGHT: :light
        SYSTEM: :system

        def self?.values: -> ::Array[Dodopayments::Models::CheckoutSessionCustomization::theme]
      end
    end
  end
end
