        three_ds_status: Dodopayments::Models::three_ds_status?,
        three_ds_version: String?
      }

    class PaymentListResponse < Dodopayments::Internal::Type::BaseModel
      attr_accessor brand_id: String

      attr_accessor created_at: Time

      attr_accessor currency: Dodopayments::Models::currency

      attr_accessor customer: Dodopayments::CustomerLimitedDetails

      attr_accessor digital_products_delivered: bool

      attr_accessor has_license_key: bool

      attr_accessor includes_usage: bool

      attr_accessor is_multi_subscription: bool

      attr_accessor metadata: Dodopayments::Models::metadata

      attr_accessor payment_id: String

      attr_accessor payment_provider: Dodopayments::Models::PaymentListResponse::payment_provider

      attr_accessor retry_attempt: Integer

      attr_accessor service_periods: ::Array[Dodopayments::SubscriptionServicePeriod]

      attr_accessor subscription_ids: ::Array[String]

      attr_accessor total_amount: Integer

      attr_accessor card_exp_month: String?

      attr_accessor card_exp_year: String?

      attr_accessor card_last_four: String?

      attr_accessor card_network: String?

      attr_accessor card_type: String?

      attr_accessor charge_type: Dodopayments::Models::charge_type?

      attr_accessor checkout_session_id: String?

