      attr_accessor subscription_id: String?

      attr_accessor three_ds_flow: Dodopayments::Models::three_ds_flow?

      attr_accessor three_ds_status: Dodopayments::Models::three_ds_status?

      attr_accessor three_ds_version: String?

      def initialize: (
        brand_id: String,
        created_at: Time,
        currency: Dodopayments::Models::currency,
        customer: Dodopayments::CustomerLimitedDetails,
        digital_products_delivered: bool,
        has_license_key: bool,
        includes_usage: bool,
        is_multi_subscription: bool,
        metadata: Dodopayments::Models::metadata,
        payment_id: String,
        payment_provider: Dodopayments::Models::PaymentListResponse::payment_provider,
        retry_attempt: Integer,
        service_periods: ::Array[Dodopayments::SubscriptionServicePeriod],
        subscription_ids: ::Array[String],
        total_amount: Integer,
        ?card_exp_month: String?,
        ?card_exp_year: String?,
        ?card_last_four: String?,
        ?card_network: String?,
        ?card_type: String?,
