        three_ds_flow: Dodopayments::Models::three_ds_flow?,
        three_ds_status: Dodopayments::Models::three_ds_status?,
        three_ds_version: String?
      }

      type payment_provider = :stripe | :adyen | :dodo

      module PaymentProvider
        extend Dodopayments::Internal::Type::Enum

        STRIPE: :stripe
        ADYEN: :adyen
        DODO: :dodo

        def self?.values: -> ::Array[Dodopayments::Models::PaymentListResponse::payment_provider]
      end
