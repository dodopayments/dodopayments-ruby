module Dodopayments
  module Models
    module Blocklist
      module Customers
        type note_request = { text: String }

        class NoteRequest < Dodopayments::Internal::Type::BaseModel
          attr_accessor text: String

          def initialize: (text: String) -> void

          def to_hash: -> { text: String }
        end
      end
    end
  end
end
