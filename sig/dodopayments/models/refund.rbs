module Dodopayments
  module Models
    type refund =
      {
        brand_id: String,
        business_id: String,
        created_at: Time,
        customer: Dodopayments::CustomerLimitedDetails,
        is_partial: bool,
        metadata: Dodopayments::Models::metadata,
        payment_id: String,
        refund_id: String,
        status: Dodopayments::Models::refund_status,
        amount: Integer?,
        currency: Dodopayments::Models::currency?,
        network_reference: String?,
        network_reference_type: Dodopayments::Models::refund_network_reference_type?,
        reason: String?
      }

    class Refund < Dodopayments::Internal::Type::BaseModel
      attr_accessor brand_id: String

      attr_accessor business_id: String

      attr_accessor created_at: Time

      attr_accessor customer: Dodopayments::CustomerLimitedDetails

      attr_accessor is_partial: bool

      attr_accessor metadata: Dodopayments::Models::metadata

      attr_accessor payment_id: String

      attr_accessor refund_id: String

      attr_accessor status: Dodopayments::Models::refund_status

      attr_accessor amount: Integer?

      attr_accessor currency: Dodopayments::Models::currency?

      attr_accessor network_reference: String?

      attr_accessor network_reference_type: Dodopayments::Models::refund_network_reference_type?

      attr_accessor reason: String?

      def initialize: (
        brand_id: String,
        business_id: String,
        created_at: Time,
        customer: Dodopayments::CustomerLimitedDetails,
        is_partial: bool,
        metadata: Dodopayments::Models::metadata,
        payment_id: String,
        refund_id: String,
        status: Dodopayments::Models::refund_status,
        ?amount: Integer?,
        ?currency: Dodopayments::Models::currency?,
        ?network_reference: String?,
        ?network_reference_type: Dodopayments::Models::refund_network_reference_type?,
        ?reason: String?
      ) -> void

      def to_hash: -> {
        brand_id: String,
        business_id: String,
        created_at: Time,
        customer: Dodopayments::CustomerLimitedDetails,
        is_partial: bool,
        metadata: Dodopayments::Models::metadata,
        payment_id: String,
        refund_id: String,
        status: Dodopayments::Models::refund_status,
        amount: Integer?,
        currency: Dodopayments::Models::currency?,
        network_reference: String?,
        network_reference_type: Dodopayments::Models::refund_network_reference_type?,
        reason: String?
      }
    end
  end
end
