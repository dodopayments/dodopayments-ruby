module Dodopayments
  module Models
    type invoice_reopened_webhook_event =
      {
        business_id: String,
        data: Dodopayments::Invoice,
        timestamp: Time,
        type: :"invoice.reopened"
      }

    class InvoiceReopenedWebhookEvent < Dodopayments::Internal::Type::BaseModel
      attr_accessor business_id: String

      attr_accessor data: Dodopayments::Invoice

      attr_accessor timestamp: Time

      attr_accessor type: :"invoice.reopened"

      def initialize: (
        business_id: String,
        data: Dodopayments::Invoice,
        timestamp: Time,
        ?type: :"invoice.reopened"
      ) -> void

      def to_hash: -> {
        business_id: String,
        data: Dodopayments::Invoice,
        timestamp: Time,
        type: :"invoice.reopened"
      }
    end
  end
end
