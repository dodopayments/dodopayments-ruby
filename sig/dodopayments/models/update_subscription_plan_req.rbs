        metadata: Dodopayments::Models::metadata?,
        on_payment_failure: Dodopayments::Models::UpdateSubscriptionPlanReq::on_payment_failure?,
        return_url: String?
      }

    class UpdateSubscriptionPlanReq < Dodopayments::Internal::Type::BaseModel
      attr_accessor product_id: String

      attr_accessor proration_billing_mode: Dodopayments::Models::UpdateSubscriptionPlanReq::proration_billing_mode

      attr_accessor quantity: Integer

      attr_accessor adaptive_currency_fees_inclusive: bool?

