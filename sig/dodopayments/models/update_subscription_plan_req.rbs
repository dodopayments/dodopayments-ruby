      type proration_billing_mode =
        :prorated_immediately
        | :full_immediately
        | :difference_immediately
        | :do_not_bill
        | :prorated_immediately_keep_cycle

      module ProrationBillingMode
        extend Dodopayments::Internal::Type::Enum

        PRORATED_IMMEDIATELY: :prorated_immediately
        FULL_IMMEDIATELY: :full_immediately
        DIFFERENCE_IMMEDIATELY: :difference_immediately
        DO_NOT_BILL: :do_not_bill
        PRORATED_IMMEDIATELY_KEEP_CYCLE: :prorated_immediately_keep_cycle

        def self?.values: -> ::Array[Dodopayments::Models::UpdateSubscriptionPlanReq::proration_billing_mode]
      end

      type credit = :customer_balance | :refund

      module Credit
        extend Dodopayments::Internal::Type::Enum

        CUSTOMER_BALANCE: :customer_balance
        REFUND: :refund

        def self?.values: -> ::Array[Dodopayments::Models::UpdateSubscriptionPlanReq::credit]
      end

      type effective_at = :immediately | :next_billing_date

      module EffectiveAt
        extend Dodopayments::Internal::Type::Enum

        IMMEDIATELY: :immediately
        NEXT_BILLING_DATE: :next_billing_date

        def self?.values: -> ::Array[Dodopayments::Models::UpdateSubscriptionPlanReq::effective_at]
      end

      type invoice =
        {
          collection_method: Dodopayments::Models::collection_method?,
          finalize: bool,
          payment_terms: Dodopayments::Models::UpdateSubscriptionPlanReq::Invoice::payment_terms?
        }

      class Invoice < Dodopayments::Internal::Type::BaseModel
        attr_accessor collection_method: Dodopayments::Models::collection_method?

        attr_reader finalize: bool?

        def finalize=: (bool) -> bool

        attr_accessor payment_terms: Dodopayments::Models::UpdateSubscriptionPlanReq::Invoice::payment_terms?

        def initialize: (
          ?collection_method: Dodopayments::Models::collection_method?,
          ?finalize: bool,
          ?payment_terms: Dodopayments::Models::UpdateSubscriptionPlanReq::Invoice::payment_terms?
        ) -> void

        def to_hash: -> {
          collection_method: Dodopayments::Models::collection_method?,
          finalize: bool,
          payment_terms: Dodopayments::Models::UpdateSubscriptionPlanReq::Invoice::payment_terms?
        }

        type payment_terms =
          Dodopayments::UpdateSubscriptionPlanReq::Invoice::PaymentTerms::DueOnReceipt
          | Dodopayments::UpdateSubscriptionPlanReq::Invoice::PaymentTerms::Net

        module PaymentTerms
          extend Dodopayments::Internal::Type::Union

          type due_on_receipt = { type: :due_on_receipt }

          class DueOnReceipt < Dodopayments::Internal::Type::BaseModel
            attr_accessor type: :due_on_receipt

            def initialize: (?type: :due_on_receipt) -> void

            def to_hash: -> { type: :due_on_receipt }
          end

          type net = { days: Integer, type: :net }

          class Net < Dodopayments::Internal::Type::BaseModel
            attr_accessor days: Integer

            attr_accessor type: :net

            def initialize: (days: Integer, ?type: :net) -> void

            def to_hash: -> { days: Integer, type: :net }
          end

          def self?.variants: -> ::Array[Dodopayments::Models::UpdateSubscriptionPlanReq::Invoice::payment_terms]
        end
      end

      type on_payment_failure = :prevent_change | :apply_change

      module OnPaymentFailure
        extend Dodopayments::Internal::Type::Enum

        PREVENT_CHANGE: :prevent_change
        APPLY_CHANGE: :apply_change

        def self?.values: -> ::Array[Dodopayments::Models::UpdateSubscriptionPlanReq::on_payment_failure]
      end
