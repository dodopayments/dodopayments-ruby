module Dodopayments
  module Models
    type customer_update_params =
      {
        customer_id: String,
        email: String?,
        metadata: Dodopayments::Models::metadata?,
        name: String?,
        phone_number: String?,
        preferred_locale: Dodopayments::Models::locale?
      }
      & Dodopayments::Internal::Type::request_parameters

    class CustomerUpdateParams < Dodopayments::Internal::Type::BaseModel
      extend Dodopayments::Internal::Type::RequestParameters::Converter
      include Dodopayments::Internal::Type::RequestParameters

      attr_accessor customer_id: String

      attr_accessor email: String?

      attr_accessor metadata: Dodopayments::Models::metadata?

      attr_accessor name: String?

      attr_accessor phone_number: String?

      attr_accessor preferred_locale: Dodopayments::Models::locale?

      def initialize: (
        customer_id: String,
        ?email: String?,
        ?metadata: Dodopayments::Models::metadata?,
        ?name: String?,
        ?phone_number: String?,
        ?preferred_locale: Dodopayments::Models::locale?,
        ?request_options: Dodopayments::request_opts
      ) -> void

      def to_hash: -> {
        customer_id: String,
        email: String?,
        metadata: Dodopayments::Models::metadata?,
        name: String?,
        phone_number: String?,
        preferred_locale: Dodopayments::Models::locale?,
