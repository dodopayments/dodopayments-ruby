module Dodopayments
  module Resources
    class Entitlements
      class Translations
        def update: (
          Dodopayments::Models::locale locale,
          id: String,
          ?activation_message: String?,
          ?description: String?,
          ?instructions: String?,
          ?name: String?,
          ?request_options: Dodopayments::request_opts
        ) -> Dodopayments::Entitlements::EntitlementTranslation

        def list: (
          String id,
          ?locale: ::Array[String],
          ?request_options: Dodopayments::request_opts
        ) -> Dodopayments::Entitlements::EntitlementTranslationsListResponse

        def delete: (
          Dodopayments::Models::locale locale,
          id: String,
          ?request_options: Dodopayments::request_opts
        ) -> nil

        def initialize: (client: Dodopayments::Client) -> void
      end
    end
  end
end
