module Dodopayments
  module Resources
    class Addons
      attr_reader translations: Dodopayments::Resources::Addons::Translations

      def create: (
        currency: Dodopayments::Models::currency,
        name: String,
        price: Integer,
        tax_category: Dodopayments::Models::tax_category,
        ?description: String?,
        ?request_options: Dodopayments::request_opts
      ) -> Dodopayments::AddonResponse

      def retrieve: (
        String id,
        ?locale: String,
        ?request_options: Dodopayments::request_opts
      ) -> Dodopayments::AddonResponse

      def update: (
        String id,
        ?currency: Dodopayments::Models::currency?,
        ?description: String?,
        ?image_id: String?,
        ?name: String?,
        ?price: Integer?,
        ?tax_category: Dodopayments::Models::tax_category?,
        ?request_options: Dodopayments::request_opts
      ) -> Dodopayments::AddonResponse

      def list: (
        ?archived: bool,
        ?locale: String,
        ?page_number: Integer,
        ?page_size: Integer,
        ?request_options: Dodopayments::request_opts
      ) -> Dodopayments::Internal::DefaultPageNumberPagination[Dodopayments::AddonResponse]

      def delete: (
        String id,
        ?request_options: Dodopayments::request_opts
      ) -> nil

      def unarchive: (
        String id,
        ?request_options: Dodopayments::request_opts
      ) -> nil

      def update_images: (
        String id,
        ?request_options: Dodopayments::request_opts
      ) -> Dodopayments::Models::AddonUpdateImagesResponse

      def initialize: (client: Dodopayments::Client) -> void
    end
  end
end
